{
  "name": "PDF 정리기",
  "short_name": "PDF 정리기",
  "description": "광고 없는 PDF 페이지 편집기 — 탭, 복사·붙여넣기, 회전, 병합, 글자 덮어쓰기",
  "lang": "ko",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eceff3",
  "theme_color": "#1f6feb",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "file_handlers": [
    {"action": "./", "accept": {"application/pdf": [".pdf"]}, "icons": [{"src": "icon-512.png", "sizes": "512x512", "type": "image/png"}]}
  ],
  "launch_handler": {"client_mode": "focus-existing"}
}
